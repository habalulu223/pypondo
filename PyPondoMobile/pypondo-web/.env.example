# PyPondo Frontend Environment Variables
# Copy this file to .env.local and update with your values

# Backend API URL for production deployments
# Examples:
#   - Local development: http://localhost:5000
#   - Deployed with ngrok: https://abc123.ngrok.io
#   - Deployed with Heroku: https://your-app.herokuapp.com
VITE_API_URL=http://localhost:5000

# API request timeout in milliseconds (default: 30000)
VITE_API_TIMEOUT=30000
