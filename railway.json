{
  "build": {
    "builder": "paketo"
  },
  "deploy": {
    "startCommand": "python app.py",
    "restartPolicyMaxRetries": 5,
    "restartPolicyWindowSeconds": 60,
    "rootDirectory": "PythonProject"
  },
  "modules": {
    "pypondo-backend": {
      "rootDirectory": "PythonProject",
      "buildCommand": "pip install -r requirements.txt",
      "startCommand": "python app.py"
    }
  }
}
